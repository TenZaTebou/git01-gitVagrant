BOX_IMAGE = "bento/debian-13"

Vagrant.configure("2") do |config|
    config.ssh.insert_key = false
    config.vm.box_check_update = false

    config.vm.provider "virtualbox" do |vb|
        vb.name = "srv01-debian"
        vb.memory = 2048
        vb.cpus = 2
    end

    config.vm.define "srv01" do |srv|
        srv.vm.box = BOX_IMAGE
        srv.vm.network "forwarded_port", guest: 22, host: 2206, host_ip: "127.0.0.1"
        srv.vm.network "forwarded_port", guest: 80, host: 8080, host_ip: "127.0.0.1"
        srv.vm.hostname = "srv01"
    end

end